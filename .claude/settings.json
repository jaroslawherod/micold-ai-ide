{
  "permissions": {
    "allow": [
      "Bash(echo * >> .git/autopilot-gate-ok)",
      "mcp__github__merge_pull_request",
      "Bash(scripts/autopilot/handoff-check.sh *)",
      "Bash(scripts/autopilot/issue.sh done *)"
    ]
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "juliusbrussee/caveman"
      }
    }
  },
  "enabledPlugins": {
    "caveman@caveman": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/scripts/autopilot/gate-hook.sh\"; [ -x \"$f\" ] || exit 0; exec \"$f\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/scripts/autopilot/agent-hook.sh\"; [ -x \"$f\" ] || exit 0; exec \"$f\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/scripts/autopilot/read-hook.sh\"; [ -x \"$f\" ] || exit 0; exec \"$f\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/scripts/autopilot/context-hook.py\"; [ -x \"$f\" ] || exit 0; exec \"$f\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}