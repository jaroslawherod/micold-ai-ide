# Spec Kit local feature pointer (per-workspace, not shared)
.specify/feature.json

# Rust
/target/
# Shared across the main checkout and every worktree (see scripts/build-lock.sh)
/target-shared/
**/*.rs.bk
*.pdb

# Stray run output. `debug/`, `release/` and `*.rlib` are deliberately absent: they only ever appear
# inside a target directory, which is already ignored whole, and as bare patterns they would also
# swallow any source directory that happened to be named that.
*.log
.env*

# Editor / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp

# The published documentation site (feature 028). Nothing the publication produces is committed:
# the theme's variables are generated from the design tokens on every build, and every screenshot
# and clip is produced during the publication that ships it (FR-011, FR-030).
/site/theme/css/tokens.css
/site/build/
/site/book/

# `site/theme/header.hbs` is generated by `stage.sh` (the version line and the per-page
# source link at the published tag), like `tokens.css` beside it.
/site/theme/header.hbs

# `site/checks/` is a Node project only because the accessibility check needs a real browser. Its
# dependencies are installed per machine (and per CI run) from `package.json`, never committed --
# `node_modules` here is ~100 MB of platform-specific binaries, and Playwright's browsers are not
# in it at all, they are downloaded to a cache outside the repository.
/site/checks/node_modules/
