# syntax=docker/dockerfile:1
# The web client image (#1732 M5, FR-022): the static Expo export of apps/client, built for the
# orchestrator address in the EXPO_PUBLIC_ORCHESTRATOR_URL build arg, served on 8731 by
# apps/client/e2e/serve.mjs as UID 65532. scripts/local-stack-kind.sh builds it as micold-web:local:
#
#   docker build -f Dockerfile.web --build-arg EXPO_PUBLIC_ORCHESTRATOR_URL=ws://127.0.0.1:8730/api/ws -t micold-web:local .
#
# Both stages are node 22 on Alpine, digest-pinned; bump them together.

FROM docker.io/library/node:22-alpine@sha256:12f54cafa58d0e96554ae05871e29663ff7241836377dc9a7916449b8adb062c AS builder
ARG EXPO_PUBLIC_ORCHESTRATOR_URL=ws://127.0.0.1:8730/api/ws
WORKDIR /src
RUN corepack enable
COPY . .
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile \
    && EXPO_PUBLIC_ORCHESTRATOR_URL="$EXPO_PUBLIC_ORCHESTRATOR_URL" pnpm --filter @micold/client web:export

FROM docker.io/library/node:22-alpine@sha256:12f54cafa58d0e96554ae05871e29663ff7241836377dc9a7916449b8adb062c
COPY --from=builder /src/apps/client/dist /srv/web
COPY apps/client/e2e/serve.mjs /srv/serve.mjs
ENV SERVE_HOST=0.0.0.0
USER 65532:65532
EXPOSE 8731
ENTRYPOINT ["node", "/srv/serve.mjs", "/srv/web", "8731"]
