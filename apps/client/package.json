{
  "name": "@micold/client",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "EXPO_PUBLIC_API_MODE=mock expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "web:export": "EXPO_PUBLIC_API_MODE=real expo export --platform web",
    "e2e": "echo 'client-e2e: Playwright arrives with M4 (T055)' >&2 && exit 1",
    "web:export:mock": "EXPO_PUBLIC_API_MODE=mock expo export --platform web --output-dir dist-mock"
  },
  "dependencies": {
    "@expo-google-fonts/fira-mono": "^0.4.1",
    "@expo-google-fonts/roboto": "^0.4.3",
    "@expo/metro-runtime": "^58.0.17",
    "@formatjs/icu-messageformat-parser": "^3.5.23",
    "@formatjs/intl": "^6.1.5",
    "@micold/protocol": "workspace:*",
    "expo": "^58.0.25",
    "expo-font": "^58.0.12",
    "expo-router": "^58.0.31",
    "expo-status-bar": "^58.0.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-native": "^0.88.1",
    "react-native-paper": "^5.15.5",
    "react-native-safe-area-context": "^5.11.1",
    "react-native-web": "^0.21.4",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native-a11y": "^3.5.1",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.14",
    "react-test-renderer": "^19.3.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2"
  }
