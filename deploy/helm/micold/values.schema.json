{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "micold chart values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "image": { "$ref": "#/definitions/image" },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "description": "Only file renders; sqlite (#1948) and postgres (#1740) are reserved and fail with a message naming both issues.",
          "type": "string",
          "enum": ["file", "sqlite", "postgres"]
        },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "size": { "type": "string", "minLength": 1 },
            "storageClass": { "type": "string" }
          },
          "required": ["enabled", "size"]
        }
      },
      "required": ["mode", "persistence"]
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "description": "Reserved for #1948 and #1740; unused by state.mode=file.",
          "type": "string"
        }
      }
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "$ref": "#/definitions/image" },
        "containerPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        }
      },
      "required": ["enabled"]
    },
    "resources": { "type": "object" },
    "global": { "type": "object" }
  },
  "required": ["image", "state"],
  "definitions": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      },
      "required": ["repository"]
    }
  }
}
