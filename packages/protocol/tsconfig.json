{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "jest"
    ],
    "lib": [
      "es2022",
      "dom"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "tests"
  ]
}
